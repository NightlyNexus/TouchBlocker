<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/buttons_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingVertical="@dimen/root_padding_vertical">

    <LinearLayout
        android:id="@+id/buttons"
        android:layout_width="256dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:animateLayoutChanges="true"
        android:orientation="vertical">

      <ImageView
          android:id="@+id/brand_icon"
          android:layout_width="256dp"
          android:layout_height="wrap_content"
          android:layout_marginBottom="32dp"
          android:contentDescription="@string/brand_icon_content_description"
          android:minHeight="32dp"
          android:src="@drawable/brand_icon" />

      <Button
          android:id="@+id/enable"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginBottom="32dp"
          android:backgroundTint="@color/enable_button_background_tint"
          android:minWidth="192dp"
          android:padding="24dp"
          android:textAllCaps="false"
          android:textColor="@color/enable_button_text"
          android:textSize="24sp"
          android:theme="@style/EnableButton" />

      <CheckBox
          android:id="@+id/keep_screen_on"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginHorizontal="12dp"
          android:layout_marginBottom="32dp"
          android:gravity="center"
          android:paddingHorizontal="8dp"
          android:text="@string/keep_screen_on"
          android:textSize="18sp" />

      <CheckBox
          android:id="@+id/change_screen_brightness"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginHorizontal="12dp"
          android:layout_marginBottom="32dp"
          android:gravity="center"
          android:paddingHorizontal="8dp"
          android:text="@string/change_screen_brightness"
          android:textSize="18sp" />

      <com.nightlynexus.touchblocker.NontoggleableCheckBox
          android:id="@+id/enable_assistant"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginHorizontal="12dp"
          android:layout_marginBottom="32dp"
          android:gravity="center"
          android:paddingHorizontal="8dp"
          android:text="@string/enable_assistant"
          android:textSize="16sp" />

      <Button
          android:id="@+id/request_add_tile_service"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center_horizontal"
          android:layout_marginBottom="32dp"
          android:backgroundTint="@color/request_add_tile_service_button_background_tint"
          android:padding="16dp"
          android:text="@string/request_add_tile_service_button"
          android:textAllCaps="false"
          android:textColor="@color/request_add_tile_service_button_text"
          android:textSize="16sp"
          android:theme="@style/RequestAddTileServiceButton" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginHorizontal="12dp"
          android:layout_marginBottom="16dp"
          android:text="@string/float_lock_view_size_label"
          android:textSize="16sp" />

      <SeekBar
          android:id="@+id/floating_lock_view_size"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginHorizontal="12dp" />
    </LinearLayout>

    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:text="@string/footer"
        android:textSize="16sp" />
  </LinearLayout>
</ScrollView>
